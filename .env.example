# Copy into your shell or an ignored .env; Django does not auto-load this file.
DEBUG=true
SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=postgresql://roots:roots@127.0.0.1:55432/roots
ALLOWED_HOSTS=localhost,127.0.0.1
# Authority for new form/CSV input and report snapshots; Lab.timezone records a setup copy.
TIME_ZONE=America/New_York
# Set DEMO_PASSWORD separately before running seed_demo (minimum 12 characters).

# Additional production host/origins (Render's own hostname is derived automatically).
# CSRF_TRUSTED_ORIGINS=https://lims.yourlab.example
# Behind a reverse proxy, the number of trusted proxies that append to X-Forwarded-For, so the
# sign-in limits apply per visitor rather than to everyone at once. See docs/operations.md.
# ALLAUTH_TRUSTED_PROXY_COUNT=1
# Or, where the platform sets a client-address header itself and clients cannot forge it:
# ALLAUTH_TRUSTED_CLIENT_IP_HEADER=X-Real-IP
# Complete replacement for the default same-origin Content Security Policy. See docs/operations.md.
# CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'
# Largest declared request body accepted, in bytes (12 MiB by default).
# MAX_REQUEST_BODY_BYTES=12582912
# HTTPS-only policy sent to browsers when DEBUG=false (seconds; one hour by default).
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Synthetic notice stays on until laboratory-controlled production configuration.
REPORT_SYNTHETIC_DATA_NOTICE=true
# Mail is disabled outside DEBUG until explicitly configured; keep credentials private.
# "Email me a sign-in code" appears only once a real EMAIL_BACKEND is set.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourlab.example
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=lims@yourlab.example
# AGPL section 13: if you modify and deploy this software, link users to your published source.
# SOURCE_CODE_URL=https://github.com/openbga/smart-roots-lims
